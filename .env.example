# ═══════════════════════════════════════════════════
# CONFIGURATION PIPEDRIVE — Nexum Inscription Form
# ═══════════════════════════════════════════════════

# Ton API token Pipedrive
# → Pipedrive > Profil > Paramètres > API > Personal API token
PIPEDRIVE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Le sous-domaine de ton Pipedrive (la partie avant .pipedrive.com)
# Ex: si ton URL est nexum.pipedrive.com → mets "nexum"
PIPEDRIVE_DOMAIN=nexum

# L'ID du pipeline "Inscription Livraison"
# → Pipedrive > Pipeline > clique sur le pipeline > l'ID est dans l'URL
# Ex: https://nexum.pipedrive.com/pipeline/5/... → PIPELINE_ID = 5
PIPEDRIVE_PIPELINE_ID=5

# L'ID de la première étape "Nouveau — Contrat envoyé"
# → Pipedrive > Paramètres > Pipeline > clique sur l'étape
# Ou via l'API: GET /stages?pipeline_id=5
PIPEDRIVE_STAGE_ID=12

# Ton ID utilisateur (pour t'assigner les deals)
# → Pipedrive > Paramètres > Utilisateurs > clique sur ton nom > ID dans l'URL
PIPEDRIVE_OWNER_ID=1

# ═══════════════════════════════════════════════════
# CHAMPS PERSONNALISÉS
# ═══════════════════════════════════════════════════
# Les "clés API" de tes champs custom Pipedrive
# → Pipedrive > Paramètres > Champs de données > clique sur le champ
# → La clé ressemble à : "abc123def456789..."
# Ou via l'API : GET /organizationFields et GET /dealFields

# Champ "SIREN" sur l'Organisation
PIPEDRIVE_FIELD_SIREN=

# Champ "Source" sur le Deal
PIPEDRIVE_FIELD_SOURCE=
